# Copiar como .env en DEPLOY_PATH del servidor y completar. Nunca versionar .env.

# Imágenes: ghcr.io/<dueño del repositorio en minúsculas>
IMAGE_PREFIX=
# Fijar un tag (por ejemplo sha-abc1234) para volver a una versión anterior
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- Secretos ---
# APP_KEY: "base64:" seguido de 32 bytes aleatorios en base64
APP_KEY=
JWT_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Solo para el seed inicial del administrador
SEED_ADMIN_PASSWORD=
MAIL_PASSWORD=

# --- Base de datos ---
DB_DATABASE=komenza
DB_USERNAME=komenza

# --- URLs públicas (con HTTPS) ---
APP_URL=
APP_WEB_URL=

# --- Email ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_ADDRESS_K=
MAIL_FROM_ADDRESS_BE=

# Opcional. Visible en el navegador: restringirla por dominio
GOOGLE_MAP_KEY=

# Proxies cuyas cabeceras X-Forwarded-* se aceptan: "*" (por defecto) o IPs/CIDR separados por coma
TRUSTED_PROXIES=*

# --- Puertos locales del servidor (el proxy HTTPS apunta acá) ---
BACKEND_PORT=8100
FRONTEND_PORT=3100
