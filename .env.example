# Ejecutar scripts/init-env.ps1: copia este archivo a .env y genera los secretos.
# Nunca versionar .env.

# --- Secretos ---
APP_KEY=
JWT_SECRET=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- Base de datos ---
DB_DATABASE=reservations_ui
DB_USERNAME=komenza

# --- Puertos en la máquina (solo 127.0.0.1) ---
BACKEND_PORT=8100
FRONTEND_PORT=3100
MOBILE_PORT=8181
MAILPIT_PORT=8125
DB_HOST_PORT=3316

# --- Aplicación ---
APP_DEBUG=true
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_ADDRESS_K=no-reply@example.com
MAIL_FROM_ADDRESS_BE=no-reply@example.com
# Opcional: sin clave no se muestra la imagen del mapa ("Cómo llegar" no la necesita).
# Clave de Google Maps, visible en el navegador: restringirla por dominio
GOOGLE_MAP_KEY=

# --- Desarrollo ---
INSTALL_XDEBUG=false
